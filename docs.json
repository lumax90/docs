            ]
          },
          {
            "group": "Projects",
            "pages": [
              "guides/projects/creating-a-project",
              "guides/projects/workflow",
              "guides/essentials/assets",
              "guides/essentials/tasks",
              "guides/essentials/label-schema",
              "guides/essentials/imports",
              "guides/essentials/exports"
            ]
          },
          {
            "group": "Annotation Editor",
            "pages": [
              "guides/annotation-modules/image-annotation-tool",
              "guides/basics/global-controls"
            ]
          },
          {
            "group": "Annotation Tools",
            "pages": [
              "guides/basics/smart-annotation-palette/smart-tool-palette",
              "guides/basics/bounding-box",
              "guides/basics/polygon",
              "guides/basics/line",
              "guides/basics/point",
              "guides/basics/freeform",
              "guides/basics/smart-annotation-palette/ocr-tool",
              "guides/basics/ai-assisted-annotation"
            ]
          },
          {
            "group": "Collaboration",
            "pages": [
              "guides/basics/comment",
              "guides/basics/guidelines"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-pixlhub.svg",
    "dark": "/images/logo-pixlhub.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:onur@pixldata.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Login",
      "href": "https://hub.pixldata.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
